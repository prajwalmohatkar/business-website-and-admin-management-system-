# ==========================================
# SERVER ENVIRONMENT CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development

# Database (MongoDB local or MongoDB Atlas)
# Example local: mongodb://127.0.0.1:27017/business_website
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/business_website?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/business_website

# Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min32chars
JWT_EXPIRES_IN=7d

# Cloudinary (Image Uploads)
# Obtain from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Allowed Client Origin (for CORS)
CLIENT_URL=http://localhost:5173

# Admin Initial Setup Credentials (Used for seeding first admin user)
ADMIN_SETUP_SECRET=setup_secret_key_change_me
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@business.com
INITIAL_ADMIN_PASSWORD=Admin@12345
