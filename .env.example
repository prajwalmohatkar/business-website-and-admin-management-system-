# ==========================================
# FULL-STACK BUSINESS WEBSITE .ENV.EXAMPLE
# ==========================================

# ----------------- BACKEND -----------------
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/business_website
JWT_SECRET=super_secret_jwt_key_change_in_production_min32chars
JWT_EXPIRES_IN=7d

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS
CLIENT_URL=http://localhost:5173

# Admin Setup
ADMIN_SETUP_SECRET=setup_secret_key_change_me
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@business.com
INITIAL_ADMIN_PASSWORD=Admin@12345

# ----------------- FRONTEND -----------------
VITE_API_URL=http://localhost:5000/api
